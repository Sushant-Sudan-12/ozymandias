    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[0].text
      value: Here they are
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[1].text
      value: Timeless Beings, poor souls corrupted by the greed to control time
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[2].text
      value: They suffer, can Ozzy help them
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[3].text
      value: TRY
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[4].text
      value: Okay, wait
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[5].text
      value: You truly are a fool
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[6].text
      value: Dont let them see you, otherwise you too will get stuck in this time
        loop.
      objectReference: {fileID: 0}
    - target: {fileID: 824554941029196113, guid: adad55824a942084686304b30e5c2004, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[7].text
